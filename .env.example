# ========================================================
# AICTE SmartVerify AI - Environment Configuration Example
# ========================================================

# Application Mode
ENVIRONMENT=development
PROJECT_NAME="AICTE SmartVerify AI"

# Database Configuration (Postgres for production, SQLite for local dev)
# Local SQLite Dev:
DATABASE_URL=sqlite:///./aicte.db
# PostgreSQL Container / Prod:
# DATABASE_URL=postgresql://aicte_user:aicte_password@localhost:5432/aicte_smartverify

# JWT & Security Secrets
SECRET_KEY=replace-with-a-cryptographically-secure-random-key-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Security Policies
CAPTCHA_EXPIRE_SECONDS=120
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
RATE_LIMIT_PER_MINUTE=5

# Cookie Flags
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# CORS Origins (JSON array format)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Frontend Target (for Vite dev server proxy)
VITE_BACKEND_URL=http://127.0.0.1:8000

